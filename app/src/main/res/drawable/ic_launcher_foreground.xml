<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    
    <!-- Stylized Back Folder Layer with a modern linear blue-cyan gradient -->
    <path
        android:pathData="M 28,34 H 44 L 50,40 H 76 C 80.4,40 84,43.6 84,48 V 74 C 84,78.4 80.4,82 76,82 H 28 C 23.6,82 20,78.4 20,74 V 38 C 20,33.6 23.6,34 28,34 Z">
