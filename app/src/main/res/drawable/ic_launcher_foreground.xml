            <gradient
                android:startX="20"
                android:startY="34"
                android:endX="84"
                android:endY="82"
                android:type="linear">
                <item android:color="#00D2C4" android:offset="0.0"/>
                <item android:color="#0EA5E9" android:offset="1.0"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Moving Documents (Symbols of files being promoted up) -->
    <!-- Document 1 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 38,24 H 50 L 56,30 V 44 H 38 Z" />
    <path
        android:fillColor="#E2E8F0"
        android:pathData="M 50,24 V 30 H 56 Z" />

    <!-- Upward promoting Arrows (Representing Untangling) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 54,46 L 48,52 H 52 V 64 H 56 V 52 H 60 Z" />

    <!-- Stylized Front Folder Flap (Open layout) -->
    <path
        android:pathData="M 20,50 H 84 V 74 C 84,78.4 80.4,82 76,82 H 28 C 23.6,82 20,78.4 20,74 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="20"
                android:startY="50"
                android:endX="84"
                android:endY="82"
                android:type="linear">
                <item android:color="#0EA5E9" android:offset="0.0"/>
                <item android:color="#0284C7" android:offset="1.0"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Folder Front Accent highlight line -->
    <path
        android:fillColor="#38BDF8"
        android:pathData="M 28,54 H 76 C 77,54 78,55 78,56 C 78,57 77,58 76,58 H 28 C 27,58 26,57 26,56 C 26,55 27,54 28,54 Z" />
</vector>
